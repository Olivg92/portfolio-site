---
// The frame of every page: language, metadata, fonts, the links search
// engines use to pair the two versions, and the header and footer.
import { getRelativeLocaleUrl } from 'astro:i18n';
import { Font } from 'astro:assets';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { ui, type Lang } from '../i18n';
import '../styles/tokens.css';
import '../styles/global.css';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** The page's path without the language prefix, '' for the home page. */
  path?: string;
  /** False for pages search engines should leave out, such as the 404. */
  indexable?: boolean;
}

const { lang, title, description, path = '', indexable = true } = Astro.props;
const absolute = (l: Lang) => new URL(getRelativeLocaleUrl(l, path), Astro.site).href;
const favicon = `${import.meta.env.BASE_URL.replace(/\/?$/, '/')}favicon.svg`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#070c16" />
    {
      indexable ? (
        <>
          <link rel="canonical" href={absolute(lang)} />
          <link rel="alternate" hreflang="en" href={absolute('en')} />
          <link rel="alternate" hreflang="fr" href={absolute('fr')} />
          <link rel="alternate" hreflang="x-default" href={absolute('en')} />
        </>
      ) : (
        <meta name="robots" content="noindex" />
      )
    }
    <link rel="icon" type="image/svg+xml" href={favicon} />
    <Font cssVariable="--font-geist" preload />
    <Font cssVariable="--font-geist-mono" preload />
  </head>
  <body>
    <a class="skip" href="#main">{ui[lang].skip}</a>
    <SiteHeader lang={lang} path={path} />
    <main id="main">
      <slot />
    </main>
    <SiteFooter lang={lang} />
  </body>
</html>

<style>
  /* Out of sight until a keyboard reaches it: the first stop on every page. */
  .skip {
    position: absolute;
    top: var(--space-3);
    left: var(--gutter);
    z-index: 10;
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-pill);
    background: var(--cyan);
    color: var(--night);
    font-weight: 600;
    text-decoration: none;
    transform: translateY(-200%);
  }

  .skip:focus {
    transform: none;
  }
</style>
