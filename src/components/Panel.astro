---
// A pane of glass over the night background, for a block that stands on its
// own: a project, a story. `as` picks the element, so the block keeps its
// meaning (an article, a section) and not only its look. It rises into view
// as the page scrolls, and the line of light along its top edge sweeps on as
// it arrives (see the reveal in global.css).
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'div'> {
  as?: 'div' | 'section' | 'article' | 'aside';
}

const { as: Tag = 'div', class: className, ...rest } = Astro.props;
---

<Tag class:list={['panel', 'reveal', className]} {...rest}>
  <slot />
</Tag>

<style>
  .panel {
    position: relative;
    padding: clamp(var(--space-5), 4vw, var(--space-7));
    border: 1px solid var(--line-soft);
    border-radius: var(--radius-l);
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--line) 7%, transparent), transparent 40%),
      color-mix(in srgb, var(--card) 70%, transparent);
    box-shadow: var(--shadow-panel);
    backdrop-filter: blur(14px);
  }

  /* A thin line of light along the top edge, where the glass catches it. */
  .panel::before {
    content: '';
    position: absolute;
    inset: -1px 12% auto;
    height: 1px;
    background: linear-gradient(90deg, transparent, color-mix(in srgb, var(--cyan) 60%, transparent), transparent);
  }

  /* The line of light along the top edge sweeps on as the panel arrives,
     like a screen of the control room powering up. */
  :global(.reveal-on) .panel::before {
    transition:
      opacity 1.2s var(--ease-reveal) 0.25s,
      scale 1.2s var(--ease-reveal) 0.25s;
  }

  :global(.reveal-on) .panel:not(:global(.is-in))::before {
    opacity: 0;
    scale: 0 1;
  }

  /* On a screen with a mouse, a panel lifts a little under the pointer and
     its edge lights up. `transform` for the lift, so it adds to the reveal,
     which moves `translate` and `scale`; the transitions of both are listed
     here, as a panel's own list would otherwise replace the reveal's. */
  @media (hover: hover) and (pointer: fine) {
    .panel {
      transition:
        transform 0.4s var(--ease-reveal),
        box-shadow 0.4s var(--ease-reveal),
        border-color 0.4s ease;
    }

    :global(.reveal-on) .panel {
      transition:
        opacity 0.9s var(--ease-reveal),
        translate 0.9s var(--ease-reveal),
        scale 0.9s var(--ease-reveal),
        transform 0.4s var(--ease-reveal),
        box-shadow 0.4s var(--ease-reveal),
        border-color 0.4s ease;
    }

    .panel:hover {
      border-color: color-mix(in srgb, var(--line) 34%, transparent);
      box-shadow:
        var(--shadow-panel),
        0 28px 60px -34px color-mix(in srgb, var(--cyan) 45%, transparent);
    }
  }

  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .panel:hover {
      transform: translateY(-4px);
    }
  }
</style>
