---
// The home page, the same in both languages apart from its words. Its first
// screen answers a recruiter in a grid of tiles: the role, a plain sentence,
// the CV, years, place and languages, a few figures, the flagship project and
// the tools. Then the strengths, the career and the two projects.
//
// Hooks of the entrance and the effects (styles at the end), stable names:
// the grid is `.bento`, its tiles `.tile` with `--n` and an area class
// (`t-intro` … `t-cv`); `.rise` with `--d` for what rises after the name;
// `#name` for the name; `.value[data-count]` for a figure that counts up;
// `svg.slabs` and its `.slab.s1` to `.s3` for the flagship's drawing.
import { getRelativeLocaleUrl } from 'astro:i18n';
import Base from '../layouts/Base.astro';
import Button from './Button.astro';
import Chip from './Chip.astro';
import Icon from './Icon.astro';
import ProjectCard from './ProjectCard.astro';
import Slabs from './Slabs.astro';
import Tile from './Tile.astro';
import ToolChip from './ToolChip.astro';
import { experience, type MetricId } from '../experience';
import { projects } from '../projects';
import { links } from '../links';
import { cvFile, cvPath } from '../cv';
import { jsonLd, profilePage } from '../structured';
import { ui, type Lang, type StrengthId } from '../i18n';
import type { ToolName } from '../tools';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
const other: Lang = lang === 'en' ? 'fr' : 'en';
const flagship = projects[0];
const school = experience.education[0];

// The tech stack of the first screen: the keywords of the approved
// prototype, in its order, as tools of the catalogue. Its "AWS" is EKS, its
// "GitLab CI" GitLab, and GitOps, a practice, is named on Argo CD's card.
const stack: ToolName[] = [
  'kubernetes',
  'terraform',
  'ansible',
  'eks',
  'argo',
  'prometheus',
  'grafana',
  'datadog',
  'vault',
  'rancher',
  'docker',
  'gitlab',
  'linux',
  'python',
];

// Each strength, with its badge's icon and the two aurora colours it is
// drawn in (no colour of its own: tokens only), and the tools behind it.
// Reliability names no tool in its words, so its row lists the four.
const strengths: { id: StrengthId; icon: 'shield' | 'flow' | 'cloud' | 'people'; from: string; to: string; tools: ToolName[] }[] = [
  { id: 'reliability', icon: 'shield', from: '--sky-green', to: '--sky-blue', tools: ['prometheus', 'grafana', 'datadog', 'elk'] },
  { id: 'automation', icon: 'flow', from: '--sky-blue', to: '--sky-violet', tools: ['ansible', 'terraform', 'argo'] },
  { id: 'platforms', icon: 'cloud', from: '--sky-violet', to: '--sky-pink', tools: ['rke2', 'rancher', 'eks'] },
  { id: 'mentoring', icon: 'people', from: '--sky-pink', to: '--sky-blue', tools: [] },
];

// A figure as the experience page states it, read by its id: a figure the
// page no longer has fails the build rather than leaving a blank tile.
const figure = (id: MetricId) => {
  const value = experience.metrics.find((metric) => metric.id === id)?.value[lang];
  if (value === undefined) throw new Error(`no metric "${id}" in experience.ts`);
  return value;
};

// Measured from a fresh clone to `make local-verify` all green, as the
// platform-eks-gitops README says; its spoken form is i18n home.numbers.clone.
const demo = '4 min 33 s';

// A figure cut into the parts its tile styles: digits (`.value`, which may
// count up), a unit (`.unit`, smaller), a space, or a sign such as ~ or +.
// The space, or no-break space, before a unit goes, so that the unit sits
// against its digits: "~15 min" reads ~15min, "4 min 33 s" 4min 33s. On a
// figure that counts up, its digits carry the value to count to.
type Part = { kind: 'value' | 'unit' | 'space' | 'sign'; text: string; count?: string | undefined };
const parts = (value: string, counts = false): Part[] =>
  (value.replace(/\s+(?=\p{L})/gu, '').match(/\d+|\p{L}+|\s+|[^\d\p{L}\s]+/gu) ?? []).map((text) => {
    if (/^\d/.test(text)) return { kind: 'value', text, count: counts ? text : undefined };
    if (/^\p{L}/u.test(text)) return { kind: 'unit', text };
    if (/^\s/.test(text)) return { kind: 'space', text: ' ' };
    return { kind: 'sign', text };
  });

// The link from the career to the experience page, as long as a sentence:
// its last word is held to its arrow, so that when it wraps, the arrow
// follows that word rather than sit alone on a line.
const more = t.home.career.more(experience.problems.length);
const lastWord = more.lastIndexOf(' ') + 1;

const numbers = t.home.numbers;
const servers = parts(figure('servers'), true);
const cluster = parts(figure('cluster'), true);
const mentor = parts(figure('apprentices'), true);
const clone = parts(demo);
---

<Base lang={lang} title={t.title} description={t.description}>
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={jsonLd(profilePage(lang, new URL(getRelativeLocaleUrl(lang), Astro.site), Astro.site!))}
  />
  <script is:inline slot="head">
    // The entrance of the home page (see its styles below), the first look a
    // visitor gets at it: once per visit (a tab), never for anyone who asks
    // for less motion, and without script the page is simply at rest. It
    // runs in the head, so that the first frame drawn is already the first
    // of the entrance, and holds it there, paused, until the first screen,
    // the styles and the fonts are in (the script after the first screen
    // says when) and the page is visible. Timers only, never animation
    // frames: WebKit does not always draw a frame for a page whose
    // animations are paused, and a prototype stayed frozen there with its
    // figures at 0. Whatever happens, the page comes to rest, flat, each
    // figure at the value the HTML holds: 1.5 s after it is first visible
    // without a start, it lets go; started, it ends with its animations,
    // 2.4 s later at most. The visit counts as seen as soon as the page has
    // been shown, played or not, so that it never plays after the visitor
    // has read the page; and a visitor who comes to a section of it
    // (/#projects) or from another page of the site has seen it already.
    (() => {
      const root = document.documentElement;
      const key = 'home-entrance';
      if (!matchMedia('screen and (prefers-reduced-motion: no-preference)').matches) return;
      const mark = () => {
        try {
          sessionStorage.setItem(key, '1');
        } catch {}
      };
      try {
        if (sessionStorage.getItem(key)) return;
      } catch {
        return;
      }
      let from = '';
      try {
        from = new URL(document.referrer).origin;
      } catch {}
      if (location.hash.length > 1 || from === location.origin) return mark();
      root.classList.add('entering', 'entering-wait');
      let state = 'waiting';
      let ready = false;
      let release;
      let ticker;
      let began;
      const figures = () => [...document.querySelectorAll('.bento .value[data-count]')];
      const finish = () => {
        state = 'done';
        clearTimeout(release);
        clearInterval(ticker);
        mark();
        root.classList.remove('entering', 'entering-wait');
        for (const figure of figures()) {
          figure.textContent = figure.dataset.count;
          figure.style.removeProperty('min-width');
        }
      };
      // Each figure counts up from 0 to the value the HTML holds, one after
      // the other in the order of their tiles, its width held at that
      // value's, so that nothing beside it moves.
      const count = () => {
        const list = figures();
        const widths = list.map((figure) => getComputedStyle(figure).width);
        list.forEach((figure, i) => {
          figure.style.minWidth = widths[i];
          figure.textContent = '0';
        });
        ticker = setInterval(() => {
          let done = true;
          list.forEach((figure, i) => {
            const p = Math.min(1, Math.max(0, (performance.now() - began - 350 - 50 * i) / 1000));
            figure.textContent = String(Math.round(Number(figure.dataset.count) * (1 - (1 - p) ** 3)));
            if (p < 1) done = false;
          });
          if (done) clearInterval(ticker);
        }, 16);
      };
      // Its animations start on the first frame drawn after the start, which
      // may come late: if one is still on its way at 1.7 s, the end waits for
      // it, until 2.4 s after the start at most.
      const names = ['plate', 'plate-phone', 'drop', 'ground', 'shine', 'rise', 'bloom'];
      const end = () => {
        const left = Math.max(
          0,
          ...document
            .getAnimations()
            .filter((animation) => names.includes(animation.animationName) && animation.playState === 'running')
            .map((animation) => animation.effect.getComputedTiming().endTime - (animation.currentTime ?? 0)),
        );
        const room = began + 2400 - performance.now();
        if (left > 0 && room > 0) setTimeout(finish, Math.min(left + 20, room));
        else finish();
      };
      const start = () => {
        if (state !== 'waiting' || !ready || document.visibilityState !== 'visible') return;
        // Scrolled while it waited: the visitor is reading already.
        if (scrollY > 0) return finish();
        state = 'playing';
        began = performance.now();
        clearTimeout(release);
        mark();
        root.classList.remove('entering-wait');
        count();
        setTimeout(end, 1700);
      };
      // The 1.5 s count from when the page is first visible: a page opened
      // behind another tab waits there, paused, for the visitor to come.
      const arm = () => {
        if (release || state !== 'waiting' || document.visibilityState !== 'visible') return;
        release = setTimeout(() => state === 'waiting' && finish(), 1500);
      };
      // Ready once the script after the first screen has run, which the
      // browser runs only once the styles are in (WebKit fires
      // DOMContentLoaded before them, at the end of a long page), and the
      // fonts of the name and of the text are in. Only the first family of
      // each is waited for: the fallback beside it is a local font, missing
      // on a phone without Arial, and its error would end the wait at once.
      // A font still on its way at 1.5 s leaves the page at rest: the
      // entrance never plays in a fallback font about to be swapped out,
      // whose figures would be held at the wrong widths. One that fails
      // (blocked, missing) ends the wait at once, like a missing local
      // font: the entrance then plays in the fallback, which stays.
      addEventListener(
        'home-hero',
        () => {
          const face = (element) => {
            const style = getComputedStyle(element);
            return `${style.fontWeight} 16px ${style.fontFamily.split(',')[0]}`;
          };
          const fonts = document.fonts ? [document.getElementById('name'), document.body].map((element) => document.fonts.load(face(element)).catch(() => {})) : [];
          Promise.all(fonts).then(() => {
            ready = true;
            start();
          });
        },
        { once: true },
      );
      document.addEventListener('visibilitychange', () => {
        arm();
        start();
      });
      arm();
      addEventListener('pagehide', finish);
    })();
  </script>
  <section class="hero bento wrap" aria-labelledby="name">
    <div class="ground" aria-hidden="true"></div>
    <Tile class="t-intro" n={0}>
      <p class="role"><span class="monogram" aria-hidden="true">OG</span>{t.jobTitle}</p>
      <h1 id="name"><span class="line">Olivier</span> <span class="line">Guandalini</span></h1>
      <p class="pitch rise" style="--d: 0.3s">{t.home.pitch}</p>
      <div class="cluster ctas rise" style="--d: 0.5s">
        <Button href={cvPath(lang)} download={cvFile(lang)}>{t.cv.cta}</Button>
        <Button href={links.linkedin} variant="ghost">{t.home.linkedin}</Button>
      </div>
    </Tile>

    <Tile class="t-status" n={1}>
      <p class="open"><span class="signal" aria-hidden="true"></span>{t.home.facts.open}</p>
      <ul class="facts" aria-label={t.home.facts.label}>
        <li><Icon name="briefcase" /><span>{t.home.facts.years}</span></li>
        <li><Icon name="pin" /><span>{t.home.facts.place}</span></li>
        <li><Icon name="globe" /><span>{t.home.facts.languages}</span></li>
      </ul>
    </Tile>

    <Tile class="stat t-servers" n={2}>
      <p class="cap">{numbers.servers.cap}</p>
      <p class="big grad">
        <span aria-hidden="true">
          {servers.map((part) => (part.kind === 'space' ? ' ' : <span class={part.kind} data-count={part.count}>{part.text}</span>))}
        </span>
        <span class="visually-hidden">{numbers.servers.spoken}</span>
      </p>
      <p class="caption">{numbers.servers.caption}</p>
    </Tile>

    <Tile class="t-visual" n={3}>
      <Slabs />
      <div class="about">
        <div class="flag">
          <p class="cap">{t.home.flagship}</p>
          <Chip tone={flagship.status === 'finished' ? 'green' : 'amber'} dot>{t.status[flagship.status]}</Chip>
        </div>
        <p class="title">{flagship.name}</p>
        <p class="text">{flagship.pitch[lang]}</p>
        {
          flagship.tour && (
            <a class="go" href={getRelativeLocaleUrl(lang, flagship.tour)}>
              {t.takeTour}
              <Icon name="arrow-right" />
            </a>
          )
        }
      </div>
    </Tile>

    <Tile class="t-words" n={4}>
      <div class="words-head">
        <p class="cap" id="stack-title">{t.home.stack}</p>
        <p class="hint">{t.experience.toolsHint}</p>
      </div>
      <ul class="cluster" aria-labelledby="stack-title">
        {
          stack.map((name) => (
            <li>
              <ToolChip name={name} context="stack" lang={lang} />
            </li>
          ))
        }
      </ul>
    </Tile>

    <Tile class="stat t-cluster" n={5}>
      <p class="cap">{numbers.cluster.cap}</p>
      <p class="big">
        <span aria-hidden="true">
          {cluster.map((part) => (part.kind === 'space' ? ' ' : <span class={part.kind} data-count={part.count}>{part.text}</span>))}
        </span>
        <span class="visually-hidden">{numbers.cluster.spoken}</span>
      </p>
      <p class="caption">{numbers.cluster.caption}</p>
    </Tile>

    <Tile class="stat t-mentor" n={6}>
      <p class="cap">{numbers.mentor.cap}</p>
      <p class="big">
        <span aria-hidden="true">
          {mentor.map((part) => (part.kind === 'space' ? ' ' : <span class={part.kind} data-count={part.count}>{part.text}</span>))}
        </span>
        <span class="visually-hidden">{numbers.mentor.spoken}</span>
      </p>
      <p class="caption">{numbers.mentor.caption}</p>
    </Tile>

    <Tile class="stat t-clone" n={7}>
      <p class="cap">{numbers.clone.cap}</p>
      <p class="big">
        <span aria-hidden="true">
          {clone.map((part) => (part.kind === 'space' ? ' ' : <span class={part.kind}>{part.text}</span>))}
        </span>
        <span class="visually-hidden">{numbers.clone.spoken}</span>
      </p>
      <p class="caption">{numbers.clone.caption}</p>
    </Tile>

    <Tile class="t-cv night" n={8}>
      <p class="cap">{t.home.cvFormat}</p>
      <a class="get" href={cvPath(lang)} download={cvFile(lang)}>
        {t.cv.cta}
        <span class="ring" aria-hidden="true"><Icon name="download" /></span>
      </a>
      <a class="other" href={cvPath(other)} download={cvFile(other)} hreflang={other}>{t.home.cvOther}</a>
    </Tile>
  </section>
  <script is:inline>
    // The first screen is in, and so are the styles: a browser runs a script
    // only once the stylesheets above it are in. The entrance, if it waits
    // (the head's script), may start.
    dispatchEvent(new Event('home-hero'));
  </script>

  <section id="strengths" class="strengths wrap" aria-labelledby="strengths-title">
    <div class="head reveal">
      <p class="eyebrow">{t.home.strengths.eyebrow}</p>
      <h2 id="strengths-title">{t.home.strengths.title}</h2>
    </div>
    <div class="strength-grid">
      {
        strengths.map(({ id, icon, from, to, tools }, i) => (
          <Tile as="article" class="strength reveal" n={i} aria-labelledby={`strength-${id}`}>
            <span class="badge" aria-hidden="true" style={`--from: var(${from}); --to: var(${to})`}>
              <Icon name={icon} />
            </span>
            <h3 id={`strength-${id}`}>{t.home.strengths.items[id].title}</h3>
            <p>{t.home.strengths.items[id].text}</p>
            {tools.length > 0 && (
              <ul class="cluster cascade">
                {tools.map((name, k) => (
                  <li style={`--i: ${k}`}>
                    <ToolChip name={name} context={`strength-${id}`} lang={lang} />
                  </li>
                ))}
              </ul>
            )}
          </Tile>
        ))
      }
    </div>
  </section>

  <section id="career" class="career wrap" aria-labelledby="career-title">
    <div class="head reveal">
      <p class="eyebrow">{t.home.career.eyebrow}</p>
      <h2 id="career-title">{t.home.career.title}</h2>
    </div>
    <div class="career-grid">
      <Tile class="path reveal" n={0}>
        <ol class="steps">
          {
            experience.path.map(({ when, role, where }) => (
              <li>
                <p class="when">{when[lang]}</p>
                <h3>{role[lang]}</h3>
                <p class="where">{where[lang]}</p>
              </li>
            ))
          }
        </ol>
      </Tile>
      <Tile class="school reveal" n={1}>
        <p class="cap">{t.experience.educationTitle}</p>
        <h3>{school.degree[lang]}</h3>
        <p class="when">{school.when[lang]}</p>
        <a class="go" href={getRelativeLocaleUrl(lang, 'experience/')}
          >{more.slice(0, lastWord)}<span class="tail">{more.slice(lastWord)}<Icon name="arrow-right" /></span></a
        >
      </Tile>
    </div>
  </section>

  <section id="projects" class="projects wrap" aria-labelledby="projects-title">
    <div class="head reveal">
      <p class="eyebrow">{t.projects}</p>
      <h2 id="projects-title">{t.projectsTitle}</h2>
      <p class="lede">{t.projectsLede}</p>
      <p class="hint">{t.toolsHint}</p>
    </div>
    <div class="project-grid">
      {projects.map((project, i) => <ProjectCard project={project} lang={lang} n={i} />)}
    </div>
  </section>
</Base>

<style>
  /* The first screen: a grid of tiles, 2 columns on a phone, 4 from 1000 px.
     Each tile is placed by its area class, written with two classes so that
     it outweighs the tile's own rule (Tile.astro). Under 560 px only the
     cluster figure moves ahead of its place in the page, beside the servers,
     and it holds nothing to focus: the reading order and the focus order
     stay those of the page at every width. */
  .bento {
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-template-areas:
      'intro intro'
      'status status'
      'servers cluster'
      'visual visual'
      'words words'
      'mentor clone'
      'cv cv';
    gap: var(--space-3);
    padding-block: var(--space-2) 0;
  }

  @media (min-width: 560px) {
    .bento {
      grid-template-areas:
        'intro intro'
        'status servers'
        'visual visual'
        'words words'
        'cluster mentor'
        'clone cv';
    }
  }

  /* On a laptop, the tools come up to the third row, so that the first
     screen holds them. */
  @media (min-width: 1000px) {
    .bento {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      grid-template-areas:
        'intro intro status servers'
        'intro intro visual visual'
        'words words cluster mentor'
        'clone clone cv cv';
    }
  }

  .bento > .t-intro {
    grid-area: intro;
  }

  .bento > .t-status {
    grid-area: status;
  }

  .bento > .t-servers {
    grid-area: servers;
  }

  .bento > .t-visual {
    grid-area: visual;
  }

  .bento > .t-words {
    grid-area: words;
  }

  .bento > .t-cluster {
    grid-area: cluster;
  }

  .bento > .t-mentor {
    grid-area: mentor;
  }

  .bento > .t-clone {
    grid-area: clone;
  }

  .bento > .t-cv {
    grid-area: cv;
  }

  /* Who, in a sentence, and the two things to do about it. */
  .bento > .t-intro {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
    padding: clamp(var(--space-5), 3.4vw, 40px);
  }

  .role {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--accent);
    font: 700 0.95rem / 1.2 var(--font-ui);
  }

  /* The initials in a ring of the aurora's colours, until a photo takes
     their place (a 44 px <img alt="">). */
  .monogram {
    display: grid;
    place-items: center;
    flex: none;
    width: 44px;
    height: 44px;
    border: 2px solid transparent;
    border-radius: 50%;
    background:
      linear-gradient(color-mix(in srgb, var(--violet) 35%, var(--surface)), color-mix(in srgb, var(--violet) 35%, var(--surface))) padding-box,
      conic-gradient(var(--sky-blue), var(--violet), var(--sky-pink), var(--sky-green), var(--sky-blue)) border-box;
    color: var(--ink);
    font: 800 0.95rem / 1 var(--font-display);
  }

  /* The name on two lines, in solid ink. */
  .t-intro h1 {
    font-size: clamp(2.75rem, 1.5rem + 4.2vw, 4.75rem);
  }

  h1 .line {
    display: block;
  }

  .pitch {
    max-width: 30ch;
    color: var(--ink);
    font: 600 clamp(1.2rem, 1rem + 0.9vw, 1.55rem) / 1.3 var(--font-display);
    letter-spacing: -0.015em;
    text-wrap: balance;
  }

  .ctas {
    gap: var(--space-3);
    margin-top: auto;
    padding-top: var(--space-3);
  }

  /* On a phone, the two calls are full width, one above the other. A label
     wider than the screen wraps, centred, rather than push its button past
     the tile; the line height is for that second line. */
  @media (max-width: 559px) {
    .ctas {
      align-self: stretch;
    }

    .ctas :global(.btn) {
      flex: 1 1 100%;
      justify-content: center;
      padding-block: var(--space-2);
      line-height: 1.2;
      white-space: normal;
      text-align: center;
    }
  }

  /* Under 360 px (a 320 px phone, the reflow width of WCAG), "Message me on
     LinkedIn" is wider than the tile with the button's usual padding: a
     narrower padding keeps both calls on one line, the same width and
     height, with the type unchanged. */
  @media (max-width: 359px) {
    .ctas :global(.btn) {
      padding-inline: var(--space-3);
    }
  }

  /* The facts a recruiter looks for, each with its icon. The dot is still:
     nothing on this screen moves on its own. */
  .bento > .t-status {
    display: grid;
    align-content: start;
    gap: var(--space-3);
  }

  .open {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font: 800 1.1rem / 1.25 var(--font-display);
  }

  .signal {
    flex: none;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--green);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--green) 16%, transparent);
  }

  .facts {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
    color: var(--ink-2);
    font-size: 0.95rem;
    line-height: 1.4;
  }

  .facts li {
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
  }

  .facts :global(.icon) {
    width: 18px;
    height: 18px;
    margin-top: 1px;
    color: var(--accent);
  }

  /* A tile's small label in grey caps. Scoped to this page on purpose: the
