---
// The Experience page, the same in both languages apart from its words: what
// I do at work, told as problems solved, then the rest of the work, the tools
// and where I use them, the path and the education. No script.
//
// Printed, or saved as a PDF, it is the CV: three A4 pages at most
// (scripts/check-experience.mjs, scripts/cv-pdf.mjs). Its words are the PDF's
// text, which a recruiter's software reads: a figure keeps the words it has
// on screen ("~15 min"), with no spoken copy beside it.
import { getRelativeLocaleUrl } from 'astro:i18n';
import Base from '../layouts/Base.astro';
import Button from './Button.astro';
import Chip from './Chip.astro';
import Icon from './Icon.astro';
import Panel from './Panel.astro';
import Tile from './Tile.astro';
import ToolChip from './ToolChip.astro';
import { experience } from '../experience';
import { cvFile, cvPath } from '../cv';
import { ui, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
const e = t.experience;
// Words between backticks are code.
const inline = (text: string) => text.split('`');
const index = (i: number) => String(i + 1).padStart(2, '0');

// A figure cut into what its tile styles: its digits, a sign (~ or +), and a
// unit, smaller, which keeps the space before it, so that the figure still
// reads "~15 min" to a screen reader and in the text of the PDF.
const parts = (value: string) =>
  value
    .split(/(\d+)/)
    .filter(Boolean)
    .map((text) => ({ kind: /^\d/.test(text) ? 'value' : /\p{L}/u.test(text) ? 'unit' : 'sign', text }));

// Words with a hyphen held whole: "on-prem" never breaks after its hyphen,
// in the introduction or under a figure. Odd parts are those words.
const whole = (text: string) => text.split(/(\S+-\S+)/);
---

<Base lang={lang} title={e.title} description={e.description} path="experience/" preview="experience">
  <header class="intro wrap">
    <div class="lead">
      <p class="eyebrow">{e.eyebrow}</p>
      <h1>{e.heading}</h1>
      <p class="lede">{whole(experience.lede[lang]).map((part, k) => (k % 2 ? <span class="whole">{part}</span> : part))}</p>
      <div class="cv">
        <Button href={cvPath(lang)} download={cvFile(lang)}>{t.cv.download}</Button>
      </div>
    </div>
    <ul class="numbers" aria-label={e.numbers}>
      {
        experience.metrics.map((metric, i) => (
          <Tile as="li" class="stat" n={i}>
            <p class:list={['big', { grad: metric.id === 'servers' }]}>
              {parts(metric.value[lang]).map((part) => (
                <span class={part.kind}>{part.text}</span>
              ))}
            </p>
            <p class="caption">{whole(metric.label[lang]).map((part, k) => (k % 2 ? <span class="whole">{part}</span> : part))}</p>
          </Tile>
        ))
      }
    </ul>
  </header>

  <section class="solved wrap" aria-labelledby="solved-title">
    <div class="head reveal">
      <p class="eyebrow">{e.solvedEyebrow}</p>
      <h2 id="solved-title">{e.solvedTitle}</h2>
      <p class="lede">{e.solvedLede}</p>
      <p class="hint">{e.toolsHint}</p>
    </div>
    <ol class="problems">
      {
        experience.problems.map((problem, i) => (
          <li id={problem.id}>
            <Tile as="article" class="problem reveal" n={0} aria-labelledby={`${problem.id}-title`}>
              <div class="rail">
                <span class="index" aria-hidden="true">
                  {index(i)}
                </span>
                <h3 id={`${problem.id}-title`}>{problem.title[lang]}</h3>
                <ul class="cluster cascade" aria-label={t.stack}>
                  {problem.stack.map((name, k) => (
                    <li style={`--i: ${k}`}>
                      <ToolChip name={name} context={problem.id} lang={lang} />
                    </li>
                  ))}
                </ul>
              </div>
              <details class="more">
                <summary>
                  <span class="label">
                    <span class="show">{e.showDetails}</span>
                    <span class="hide">{e.hideDetails}</span>
                  </span>
                  <span class="ring">
                    <Icon name="chevron-down" />
                  </span>
                </summary>
                <dl class="story">
                  <div class="reveal-part">
                    <dt>{e.problem}</dt>
                    <dd>{problem.problem[lang]}</dd>
                  </div>
                  <div class="reveal-part">
                    <dt>{e.did}</dt>
                    <dd>{problem.did[lang]}</dd>
                  </div>
                  <div class="result reveal-part">
                    <dt>{e.result}</dt>
                    <dd>{inline(problem.result[lang]).map((part, k) => (k % 2 ? <code>{part}</code> : part))}</dd>
                  </div>
                </dl>
              </details>
            </Tile>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="also wrap" aria-labelledby="also-title">
    <h2 id="also-title" class="reveal">{e.alsoTitle}</h2>
    <ul class="lines">
      {
        experience.also.map((item) => (
          <li class="reveal">
            {item.ongoing && (
              <Chip tone="amber" live>
                {e.ongoing}
              </Chip>
            )}
            <span>{item.text[lang]}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="tools wrap" aria-labelledby="tools-title">
    <h2 id="tools-title" class="reveal">{e.stackTitle}</h2>
    <div class="columns">
      <Panel class="column" data-tone="green">
        <h3>{e.atWork}</h3>
        <ul class="cluster cascade">
          {
            experience.stack.work.map((name, i) => (
              <li style={`--i: ${i}`}>
                <ToolChip name={name} context="work" lang={lang} />
              </li>
            ))
          }
        </ul>
      </Panel>
      <Panel class="column" data-tone="cyan">
        <h3>{e.inProjects}</h3>
        <ul class="cluster cascade">
          {
            experience.stack.projects.map((name, i) => (
              <li style={`--i: ${i}`}>
                <ToolChip name={name} context="projects" lang={lang} />
              </li>
            ))
          }
        </ul>
      </Panel>
    </div>
  </section>

  <div class="history wrap">
    <section aria-labelledby="path-title">
      <h2 id="path-title" class="reveal">{e.pathTitle}</h2>
      <ol class="timeline">
        {
          experience.path.map((step) => (
            <li class="reveal">
              <p class="when">{step.when[lang]}</p>
              <h3>{step.role[lang]}</h3>
              <p>{step.where[lang]}</p>
            </li>
          ))
        }
      </ol>
    </section>
    <section aria-labelledby="education-title">
      <h2 id="education-title" class="reveal">{e.educationTitle}</h2>
      <ol class="timeline">
        {
          experience.education.map((degree) => (
            <li class="reveal">
              <p class="when">{degree.when[lang]}</p>
              <h3>{degree.degree[lang]}</h3>
              <p>{degree.note[lang]}</p>
            </li>
          ))
        }
      </ol>
      <p class="languages reveal">
        <span class="eyebrow">{e.languages}</span>
        <span>{experience.languages[lang]}</span>
      </p>
    </section>
  </div>

  <section class="next wrap" aria-labelledby="next-title">
    <Panel class="next-panel">
      <h2 id="next-title">{e.nextTitle}</h2>
      <p class="lede">{e.nextText}</p>
      <div class="cluster actions">
        <Button href={`${getRelativeLocaleUrl(lang)}#projects`}>{t.seeProjects}</Button>
        <Button href={getRelativeLocaleUrl(lang, 'platform-eks-gitops/')} variant="ghost">{t.takeTour}</Button>
      </div>
    </Panel>
  </section>
</Base>

<style>
  /* The introduction: who, what, the CV, and four figures, each a tile. On
     a laptop the figures stand two by two beside the words. */
  .intro {
    display: grid;
    gap: var(--space-6);
    padding-block: var(--space-7) 0;
  }

  .lead {
    display: grid;
    justify-items: start;
    gap: var(--space-5);
  }

  .intro h1 {
    font-size: clamp(2.25rem, 1.2rem + 4.4vw, 4.75rem);
    max-width: 13em;
  }

  /* On a phone, closer to the header, as the home page's first tile is, so
     that the first figures show above the fold of an iPhone. */
  @media (max-width: 559px) {
    .intro {
      padding-block: var(--space-2) 0;
      gap: var(--space-4);
    }

    .lead {
      gap: var(--space-4);
    }

    .intro .lede {
      font-size: var(--text-m);
    }

    /* With a larger default font, the button's words wrap rather than push
       the page past a 320 px screen, as the home page's calls do. */
    .cv :global(.btn) {
      padding-block: var(--space-2);
      line-height: 1.2;
      white-space: normal;
      text-align: center;
    }
  }

  .numbers {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 720px) {
    .numbers {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (min-width: 1000px) {
    .intro {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      align-items: end;
      column-gap: var(--space-7);
    }

    .numbers {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* A figure as on the home page: large, in the display face; its unit
     smaller and grey. Its size is held to its tile's width too (36cqi: the
     widest, "~15 min", takes about 2.6 em), so that it never runs past the
     tile, whatever the screen or the reader's default font size. The tile
     can be a size container: it holds no chip, so nothing in it opens a
     card that the containment would catch. */
  .tile.stat {
    container-type: inline-size;
    display: grid;
    align-content: start;
    gap: var(--space-2);
  }

  .big {
    color: var(--ink);
    font: 800 min(clamp(2.25rem, 1.6rem + 2.4vw, 3.5rem), 36cqi) / 1 var(--font-display);
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .unit {
    color: var(--muted);
    font-size: 0.45em;
    letter-spacing: 0;
  }

  /* The one figure in a gradient, as on the home page: every stop reads at
     3:1 or more as large text, and `color` stays the accent, which is what
     contrast checks read. Solid where colours are forced, and on paper. */
  .grad {
    color: var(--accent);
    background: linear-gradient(
      120deg,
      var(--accent),
      color-mix(in srgb, var(--violet) 55%, var(--accent)) 45%,
      color-mix(in srgb, var(--cyan) 70%, var(--accent))
    );
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  @media (forced-colors: active) {
    .grad {
      background: none;
      -webkit-text-fill-color: currentColor;
    }
  }

  .caption {
    color: var(--ink-2);
    font-size: var(--text-s);
    line-height: 1.45;
  }

  .whole {
    white-space: nowrap;
  }

  .solved,
  .also,
  .tools,
  .history,
  .next {
    margin-top: var(--space-9);
  }

  @media (max-width: 559px) {
    .solved,
    .also,
    .tools,
    .history,
    .next {
      margin-top: var(--space-8);
    }
  }

  .head {
    display: grid;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
  }

  /* The chips open a card: said once, quietly, above them. */
  .hint {
    color: var(--muted);
    font-size: var(--text-s);
  }

  .problems {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .problems > li {
    scroll-margin-top: var(--space-5);
  }

  /* A problem reads as a case file: its number and title, its tools below,
     the story told in three steps, the last one lit, since it is what
     changed. Two classes, to weigh more than the tile's own rule. */
  .tile.problem {
    display: grid;
    gap: var(--space-5);
    padding: clamp(20px, 3vw, var(--space-6));
  }

  /* The number sits on the title's first line, a quiet mark in the accent;
     the tools take the whole width below. */
  .rail {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-content: start;
    align-items: baseline;
    justify-items: start;
    gap: var(--space-4) var(--space-3);
  }

  .rail > ul {
    grid-column: 1 / -1;
  }

  .index {
    color: var(--accent);
    font: 800 1rem / 1 var(--font-display);
    font-variant-numeric: tabular-nums;
  }

  .rail h3 {
    font-size: clamp(1.375rem, 1.1rem + 1vw, 1.75rem);
    font-weight: 800;
  }

  .story {
    display: grid;
    gap: var(--space-5);
    margin: 0;
  }

  .story > div {
    display: grid;
    gap: var(--space-2);
    padding-left: var(--space-4);
    border-left: 2px solid var(--line-soft);
  }

  /* The labels of the story, as the tiles' small labels: grey caps. */
  dt {
    color: var(--muted);
    font: 700 var(--label) / 1.4 var(--font-ui);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  dd {
    margin: 0;
    color: var(--ink-2);
  }

  .story > .result {
    border-left-color: var(--green);
  }

  .result dt {
    color: var(--green);
  }

  .result dd {
    color: var(--ink);
    font-weight: 650;
  }

  /* The problem, what I did and the result, each as it comes into view
     (reveal-part), one after the other when they arrive together. */
  .story > div:nth-child(2) {
    transition-delay: 0.12s;
  }

  .story > div:nth-child(3) {
    transition-delay: 0.24s;
  }

  @media (min-width: 900px) {
    .tile.problem {
      grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
      gap: var(--space-7);
    }
  }

  /* On a phone, the story stacks under its title, and the seven problems
     would take seven screens: each shows its number, title and tools, and
     its story unfolds from a line at the foot of the card, its chevron in a
     ring lit with the aurora. */
  .more > summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    min-height: 48px;
    padding-top: var(--space-4);
    border-top: 1px solid var(--line-soft);
    color: var(--accent);
    font: 700 0.95rem / 1.3 var(--font-ui);
    list-style: none;
    cursor: pointer;
    transition: margin-bottom 0.45s var(--ease-reveal);
  }

  /* Safari still draws its own triangle. */
  .more > summary::-webkit-details-marker {
    display: none;
  }

  .ring {
    display: grid;
    place-items: center;
    flex: none;
    width: 32px;
    height: 32px;
    border: 1px solid color-mix(in srgb, var(--accent) 35%, transparent);
    border-radius: 50%;
    background: color-mix(in srgb, var(--surface) 70%, transparent);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--violet) 14%, transparent);
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease;
  }

  .ring :global(.icon) {
    width: 14px;
    height: 14px;
    transition: rotate 0.3s var(--ease-reveal);
  }

  .more[open] .ring :global(.icon) {
    rotate: 180deg;
  }

  /* Only under a mouse: on a phone, the hover would stay after the tap. */
  @media (hover: hover) {
    .more > summary:hover .ring {
      border-color: var(--accent);
      background: color-mix(in srgb, var(--accent) 8%, var(--surface));
    }
  }

  .more[open] > summary {
    margin-bottom: var(--space-5);
  }

  .more[open] .show,
  .more:not([open]) .hide {
    display: none;
  }

  /* The story unfolds: it opens to its height as it fades in, and folds
     back the same way. Its row grows from 0fr to 1fr, which every engine
     animates, and its words stay shown until the folding ends. Folded, it
     waits at the page's faintest opacity, as everything does here, never at
     0; it holds no link or button, and is not drawn at all once folded. */
  .more::details-content {
    display: grid;
    grid-template-rows: 0fr;
    overflow: hidden;
    opacity: var(--reveal-faint);
    transition:
      grid-template-rows 0.45s var(--ease-reveal),
      opacity 0.35s ease,
      content-visibility 0.45s allow-discrete;
  }

  .more[open]::details-content {
    grid-template-rows: 1fr;
    opacity: 1;
  }

  .more .story {
    min-height: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .more > summary,
    .more::details-content,
    .ring,
    .ring :global(.icon) {
      transition: none;
    }
  }

  /* On a wide screen, the story reads beside its title, as it always has:
     no button, the story shown whether the <details> is open or not. A
     browser that cannot style its content keeps the button there too. */
  @supports selector(::details-content) {
    @media (min-width: 900px) {
      .more > summary {
        display: none;
      }

      .more::details-content {
        display: block;
        overflow: visible;
        opacity: 1;
        content-visibility: visible;
        transition: none;
      }
    }
  }

  /* On paper, or saved as a PDF: a CV of a few A4 pages. Every story shows,
     with nothing to press, each step's label running into its words; the
     path and the education sit side by side; the hint about tools, the
     button of the CV, which this paper is, and the links to the other pages
     go. The timeline is drawn whole, whether its steps have come into view on
     screen or not. */
  @media print {
    .more > summary,
    .cv {
      display: none;
    }

    .more::details-content {
      display: block;
      overflow: visible;
      opacity: 1;
      content-visibility: visible;
    }

    .intro {
      gap: var(--space-3);
      padding-block: 0;
    }

    .lead {
      gap: var(--space-3);
    }

    .intro h1 {
      max-width: none;
      font-size: var(--text-h1);
    }

    .numbers {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--space-2);
      margin-top: var(--space-2);
    }

    .numbers .tile.stat {
      gap: var(--space-1);
      padding: var(--space-2) var(--space-3);
      border-radius: var(--radius-m);
    }

    .big {
      font-size: 14pt;
    }

    .grad {
      background: none;
      -webkit-text-fill-color: currentColor;
    }

    .solved,
    .also,
    .tools,
    .history,
    .next {
      margin-top: var(--space-8);
    }

    .hint {
      display: none;
    }

    .head {
      gap: var(--space-2);
      margin-bottom: var(--space-4);
    }

    .problems,
    .tile.problem {
      gap: var(--space-3);
    }

    /* A fine rule between blocks rather than a frame around each, and a page
       may turn between two steps of a story, never inside one. */
    .problems .tile.problem,
    .tools .column,
    .next .next-panel {
      padding: var(--space-4) 0 0;
      border: 0;
      border-top: 1px solid var(--line-soft);
      border-radius: 0;
      background: none;
      break-inside: auto;
    }

    .rail,
    .story {
      gap: var(--space-2);
    }

    .rail,
    .story > div {
      break-inside: avoid;
    }

    .rail {
      break-after: avoid;
    }

    .index {
      font-size: var(--text-s);
    }

    .rail h3 {
      font-size: 12pt;
    }

    .story > div {
      display: block;
      border-left-width: 1px;
    }

    dt {
      display: inline;
      margin-right: var(--space-2);
    }

    dd {
      display: inline;
    }

    .lines li,
    .timeline li {
      break-inside: avoid;
    }

    .history {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-6);
    }

    .timeline::before {
      scale: none !important;
    }

    .timeline li::before {
      background-color: var(--cyan) !important;
      box-shadow: none !important;
    }

    .actions {
      display: none;
    }
  }

  .also h2,
  .tools h2,
  .history h2 {
    margin-bottom: var(--space-5);
  }

  .lines {
    display: grid;
    gap: var(--space-4);
    max-width: 52rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Each line hangs from a small lit square, the way a list shows on a
     control panel. */
  .lines li {
    position: relative;
    padding-left: var(--space-5);
    color: var(--ink-2);
  }

  /* What is under way says so first, on the same line as its words. */
  .lines :global(.chip) {
    margin-right: var(--space-2);
  }

  .lines li::before {
    content: '';
    position: absolute;
    top: 0.62em;
    left: 0;
    width: 6px;
    height: 6px;
    border-radius: 2px;
    background: var(--cyan);
    box-shadow: 0 0 8px color-mix(in srgb, var(--cyan) 60%, transparent);
  }

  .columns {
    display: grid;
    gap: var(--space-5);
  }

  .column {
    --tone: var(--green);
    display: grid;
    align-content: start;
    gap: var(--space-5);
  }

  .column[data-tone='cyan'] {
    --tone: var(--cyan);
  }

  .column h3 {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--tone);
    font: 500 var(--label) / 1.4 var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .column h3::before {
    content: '';
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: currentColor;
    box-shadow: 0 0 10px currentColor;
  }

  @media (min-width: 900px) {
    .columns {
      grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    }
  }

  .history {
    display: grid;
    gap: var(--space-8);
  }

  @media (min-width: 900px) {
    .history {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-7);
    }
  }

  /* A line down the side, a lit point at each step. */
  .timeline {
    position: relative;
    display: grid;
    gap: var(--space-6);
    margin: 0;
    padding: 0 0 0 var(--space-5);
    border-left: 1px solid var(--line-soft);
    list-style: none;
  }

  .timeline li {
    position: relative;
    display: grid;
    gap: var(--space-2);
  }

  .timeline li::before {
    content: '';
    position: absolute;
    top: 0.2em;
