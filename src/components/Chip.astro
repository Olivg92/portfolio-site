---
// A short label: a technology, a status. The tone carries the meaning the
// signal colours have everywhere on the site (see tokens.css). A technology
// shows its logo; a status shows a dot, and a live dot pulses, for what is
// running.
//
// With a `tip`, the chip says what it names: it becomes a button that opens
// its card (ToolCard) on a click, a tap or the keyboard, through the Popover
// API, and on hover where the browser supports interest invokers. No script.
import type { HTMLAttributes } from 'astro/types';
import Logo from './Logo.astro';
import ToolCard from './ToolCard.astro';
import type { Tip } from '../tools';
import type { LogoName } from '../logos';

interface Props extends HTMLAttributes<'span'> {
  tone?: 'neutral' | 'cyan' | 'green' | 'amber' | 'magenta' | 'red';
  logo?: LogoName | undefined;
  dot?: boolean;
  live?: boolean;
  /** What the chip names, shown on a card. */
  tip?: Tip | undefined;
}

const { tone = 'neutral', logo, dot = false, live = false, tip, class: className, ...rest } = Astro.props;
// Attributes the type definitions do not know yet.
const invoker = tip && { popovertarget: tip.id, popovertargetaction: 'show' as const, interestfor: tip.id };
---

{
  tip ? (
    <>
      <button type="button" class:list={['chip', className]} data-tone={tone} style={`anchor-name: --${tip.id}`} {...invoker}>
        {logo && <Logo name={logo} size={15} />}
        <slot />
      </button>
      <ToolCard {...tip} logo={logo} />
    </>
  ) : (
    <span class:list={['chip', className]} data-tone={tone} {...rest}>
      {logo && <Logo name={logo} size={15} />}
      {(dot || live) && <span class:list={['dot', { live }]} aria-hidden="true" />}
      <slot />
    </span>
  )
}

<style>
  .chip {
    --tone: var(--ink-2);
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 28px;
    padding: 0 11px;
    border: 1px solid color-mix(in srgb, var(--tone) 34%, transparent);
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--tone) 8%, transparent);
    color: var(--tone);
    font: 500 0.78125rem/1 var(--font-mono);
    letter-spacing: 0.02em;
    white-space: nowrap;
    /* With or without a logo, chips in a row line up on their middle. */
    vertical-align: middle;
  }

  .chip[data-tone='neutral'] {
    border-color: var(--line-soft);
    background: var(--glass);
  }

  .chip[data-tone='cyan'] {
    --tone: var(--cyan);
  }

  .chip[data-tone='green'] {
    --tone: var(--green);
  }

  .chip[data-tone='amber'] {
    --tone: var(--amber);
  }

  .chip[data-tone='magenta'] {
    --tone: var(--magenta);
  }

  .chip[data-tone='red'] {
    --tone: var(--red);
  }

  .dot {
    position: relative;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: currentColor;
    box-shadow: 0 0 10px currentColor;
  }

  /* The pulse is a copy of the dot that grows and fades: transform and
     opacity only, so the browser animates it without repainting the page. */
  .live::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: currentColor;
    animation: ping 2.2s ease-out infinite;
  }

  @keyframes ping {
    from {
      transform: scale(1);
      opacity: 0.7;
    }
    to {
      transform: scale(2.8);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .live::after {
      animation: none;
      opacity: 0;
    }
  }

  /* A chip that explains itself: the same look, as a button. The hover
     waits a moment, so that a pointer passing over a row opens nothing. */
  button.chip {
    margin: 0;
    cursor: pointer;
    interest-delay: 0.35s 0.2s;
  }

  /* :is() ignores the states a browser does not know, instead of the rule. */
  button.chip:is(:hover, :focus-visible, :interest-source) {
    border-color: color-mix(in srgb, var(--line) 55%, transparent);
    color: var(--ink);
  }

  /* While its card is open, the chip stays lit. */
  button.chip:has(+ :global(.tool-card:popover-open)) {
    border-color: color-mix(in srgb, var(--cyan) 60%, transparent);
    background: color-mix(in srgb, var(--cyan) 10%, transparent);
    color: var(--ink);
  }
</style>
