---
// The frame of every page: language, metadata, fonts, the links search
// engines use to pair the two versions, and the header and footer.
import { getRelativeLocaleUrl } from 'astro:i18n';
import { Font } from 'astro:assets';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { ui, type Lang } from '../i18n';
import '../styles/tokens.css';
import '../styles/global.css';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** The page's path without the language prefix, '' for the home page. */
  path?: string;
  /** False for pages search engines should leave out, such as the 404. */
  indexable?: boolean;
  /** The picture of a link preview, under public/og/, without the language. */
  preview?: 'home' | 'tour' | 'experience';
}

const { lang, title, description, path = '', indexable = true, preview = 'home' } = Astro.props;
const absolute = (l: Lang) => new URL(getRelativeLocaleUrl(l, path), Astro.site).href;
// What a link preview shows, on LinkedIn and elsewhere: the page's title and
// description, and a picture drawn from the page (scripts/og-images.mjs).
const picture = new URL(`${import.meta.env.BASE_URL.replace(/\/?$/, '/')}og/${preview}-${lang}.jpg`, Astro.site).href;
const locales = { en: 'en_US', fr: 'fr_FR' } as const;
const favicon = `${import.meta.env.BASE_URL.replace(/\/?$/, '/')}favicon.svg`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#070c16" />
    <script is:inline>
      // Reveal on scroll (see global.css): only where motion is welcome and the
      // browser can watch what comes into view; each block is marked once.
      if (matchMedia('(prefers-reduced-motion: no-preference)').matches && 'IntersectionObserver' in window) {
        document.documentElement.classList.add('reveal-on');
        addEventListener('DOMContentLoaded', () => {
          const watch = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (!entry.isIntersecting) continue;
                entry.target.classList.add('is-in');
                watch.unobserve(entry.target);
              }
            },
            { rootMargin: '0px 0px -8% 0px' },
          );
          for (const block of document.querySelectorAll('.reveal, .reveal-part, .cascade')) watch.observe(block);
        });
      }

      // On a phone, a tool's card is a sheet at the bottom of the screen (see
      // ToolCard.astro): once the page scrolls on, it goes, rather than cover
      // what comes up; a slight move does not count. It fades out first,
      // still open, then closes: 0.25 s, as its `leaving` style says. On a
      // wider screen it stays, as it scrolls with its chip.
      {
        const sheet = matchMedia('(max-width: 559px)');
        const calm = matchMedia('(prefers-reduced-motion: reduce)');
        addEventListener(
          'toggle',
          (event) => {
            const card = event.target;
            if (event.newState !== 'open' || !card.matches('.tool-card')) return;
            card.classList.remove('leaving');
            if (!sheet.matches) return;
            const from = scrollY;
            const away = () => {
              if (card.matches(':popover-open') && Math.abs(scrollY - from) < 40) return;
              removeEventListener('scroll', away);
              if (!card.matches(':popover-open')) return;
              if (calm.matches) return card.hidePopover();
              card.classList.add('leaving');
              setTimeout(() => {
                if (card.matches(':popover-open.leaving')) card.hidePopover();
                card.classList.remove('leaving');
              }, 250);
            };
            addEventListener('scroll', away, { passive: true });
          },
          true,
        );
      }
    </script>
    {
      indexable ? (
        <>
          <link rel="canonical" href={absolute(lang)} />
          <link rel="alternate" hreflang="en" href={absolute('en')} />
          <link rel="alternate" hreflang="fr" href={absolute('fr')} />
          <link rel="alternate" hreflang="x-default" href={absolute('en')} />
          <meta property="og:type" content="website" />
          <meta property="og:site_name" content="Olivier Guandalini" />
          <meta property="og:url" content={absolute(lang)} />
          <meta property="og:title" content={title} />
          <meta property="og:description" content={description} />
          <meta property="og:locale" content={locales[lang]} />
          <meta property="og:locale:alternate" content={locales[lang === 'en' ? 'fr' : 'en']} />
          <meta property="og:image" content={picture} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta property="og:image:alt" content={ui[lang].previewAlt[preview]} />
          <meta name="twitter:card" content="summary_large_image" />
        </>
      ) : (
        <meta name="robots" content="noindex" />
      )
    }
    <link rel="icon" type="image/svg+xml" href={favicon} />
    <Font cssVariable="--font-geist" preload />
    <Font cssVariable="--font-geist-mono" preload />
  </head>
  <body>
    <a class="skip" href="#main">{ui[lang].skip}</a>
    <SiteHeader lang={lang} path={path} />
    <main id="main">
      <slot />
    </main>
    <SiteFooter lang={lang} />
  </body>
</html>

<style>
  /* Out of sight until a keyboard reaches it: the first stop on every page. */
  .skip {
    position: absolute;
    top: var(--space-3);
    left: var(--gutter);
    z-index: 10;
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-pill);
    background: var(--cyan);
    color: var(--night);
    font-weight: 600;
    text-decoration: none;
    transform: translateY(-200%);
  }

  .skip:focus {
    transform: none;
  }
</style>
