---
// A tool's logo, drawn inline. It always sits next to the tool's name, so
// screen readers skip it.
import { logos, type LogoName } from '../logos';

interface Props {
  name: LogoName;
  size?: number;
}

const { name, size = 16 } = Astro.props;
const logo: { viewBox: string; body: string; aspect?: number } = logos[name];
// A wide logo, such as a wordmark, keeps the height and takes the width it needs.
const width = Math.round(size * (logo.aspect ?? 1));
---

<svg class="logo" viewBox={logo.viewBox} width={width} height={size} aria-hidden="true" focusable="false" set:html={logo.body} />

<style>
  .logo {
    flex: none;
  }
</style>
