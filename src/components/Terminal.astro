---
// A terminal transcript, pasted as the command printed it, so what the site
// shows is what a reader gets when they run it. A few rules colour it:
// - a line that starts with "$ " is a command;
// - a line that starts with "# " is a note for the reader, not output;
// - a status word standing alone, at the start of a line or after two
//   spaces, says whether a step worked: ok and ✓ did, FAIL and FAILED did not;
// - pre-commit's verdict after its row of dots: Passed, Failed or Skipped.
// Everything else is output, as printed.
interface Props {
  /** The title bar: the command, or the directory it runs in. */
  title: string;
  /** The transcript, one line per line, indentation kept. */
  transcript: string;
  /** A prompt waiting at the end, with a blinking cursor. */
  cursor?: boolean;
  /** The line being explained, counted from 0, picked out in amber. */
  current?: number | undefined;
}

const { title, transcript, cursor = true, current } = Astro.props;

// A line is a few runs of text; only the runs with a tone are wrapped.
type Run = { text: string; tone?: 'prompt' | 'cmd' | 'note' | 'ok' | 'fail' };

const STATUS = /(?:^|(?<=\s{2}))(?:ok|✓|FAILED|FAIL)(?=\s|$)|(?<=\.{3})(?:Passed|Failed|Skipped)$/g;

const runs = (line: string): Run[] => {
  if (line.startsWith('$ ')) return [{ text: '$', tone: 'prompt' }, { text: line.slice(1), tone: 'cmd' }];
  if (line.startsWith('# ')) return [{ text: line, tone: 'note' }];
  const out: Run[] = [];
  let last = 0;
  for (const match of line.matchAll(STATUS)) {
    const word = match[0];
    const tone = ['ok', '✓', 'Passed'].includes(word) ? 'ok' : word === 'Skipped' ? 'note' : 'fail';
    out.push({ text: line.slice(last, match.index) }, { text: word, tone });
    last = match.index + word.length;
  }
  out.push({ text: line.slice(last) });
  return out.filter((run) => run.text);
};

const lines = transcript.replace(/^\n+|\s+$/g, '').split('\n').map(runs);
---

<figure class="term">
  <figcaption class="bar">{title}</figcaption>
  {/* Focusable, so a keyboard can scroll the lines that are wider than the screen.
      Kept on one line: inside <pre>, any space in the markup would show. */}
  <pre class="body" tabindex="0" lang="en"><code>{lines.map((line, i) => <>{i > 0 && '\n'}<span class:list={[{ current: i === current }]}>{line.map((run) => (run.tone ? <span class={run.tone}>{run.text}</span> : run.text))}</span></>)}{cursor && <>{'\n'}<span aria-hidden="true"><span class="prompt">$</span> <span class="cursor"></span></span></>}</code></pre>
</figure>

<style>
  .term {
    margin: 0;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--cyan) 25%, transparent);
    border-radius: var(--radius-m);
    background: color-mix(in srgb, var(--term-bg) 85%, transparent);
    box-shadow:
      0 0 40px color-mix(in srgb, var(--cyan) 8%, transparent) inset,
      0 24px 60px -36px var(--term-bg);
  }

  .bar {
    padding: var(--space-2) var(--space-4);
    border-bottom: 1px solid var(--line-faint);
    color: var(--muted);
    font: 500 var(--label) / 1.6 var(--font-mono);
    letter-spacing: 0.04em;
  }

  .body {
    margin: 0;
    padding: var(--space-4);
    overflow-x: auto;
    color: var(--ink-2);
    font: 400 0.8125rem / 1.75 var(--font-mono);
    tab-size: 4;
  }

  .body:focus-visible {
    outline-offset: -2px;
  }

  /* Not the inline code of the text around: the terminal sets the type. */
  .body code {
    color: inherit;
    font: inherit;
  }

  .cmd {
    color: var(--ink);
  }

  .prompt,
  .ok {
    color: var(--green);
  }

  .fail {
    color: var(--red);
  }

  .note {
    color: var(--muted);
  }

  .current {
    color: var(--amber);
    text-shadow: 0 0 12px color-mix(in srgb, var(--amber) 40%, transparent);
  }

  .current .ok {
    color: inherit;
  }

  .cursor {
    display: inline-block;
    width: 0.6em;
    height: 1.15em;
    vertical-align: text-bottom;
    background: var(--amber);
    box-shadow: 0 0 12px color-mix(in srgb, var(--amber) 45%, transparent);
    animation: blink 1.1s steps(1) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cursor {
      animation: none;
    }
  }
</style>
