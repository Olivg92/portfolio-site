---
// A link that looks like a button. Every action on the site goes somewhere,
// so there is no <button> here. The arrow says where: down for a place on the
// same page, up and to the right for another site, which opens in a new tab
// so that this one stays open behind it; screen readers hear it said. A file
// to download, the CV, gets a download arrow.
import type { HTMLAttributes } from 'astro/types';
import Icon from './Icon.astro';
import { ui, type Lang } from '../i18n';

interface Props extends HTMLAttributes<'a'> {
  href: string;
  /** Primary for the one action a section leads to, ghost for the others. */
  variant?: 'primary' | 'ghost';
}

const { href, variant = 'primary', class: className, ...rest } = Astro.props;
const elsewhere = /^https?:/.test(href);
const icon = Astro.props.download ? 'download' : href.startsWith('#') ? 'arrow-down' : elsewhere ? 'arrow-up-right' : undefined;
const lang = (Astro.currentLocale ?? 'en') as Lang;
const newTab = elsewhere ? { target: '_blank', rel: 'noopener' } : {};
// Printed after the words of a link to another site: its address, short.
const address = elsewhere ? { 'data-address': href.replace(/^https?:\/\/(www\.)?/, '') } : {};
---

<a href={href} class:list={['btn', variant, className]} {...newTab} {...address} {...rest}>
  <slot />
  {elsewhere && <span class="visually-hidden">{ui[lang].newTab}</span>}
  {icon && <Icon name={icon} />}
</a>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    padding: 0 var(--space-5);
    border: 1px solid transparent;
    border-radius: var(--radius-pill);
    font: 700 0.98rem/1 var(--font-ui);
    text-decoration: none;
    white-space: nowrap;
    transition:
      translate 0.25s var(--ease-reveal),
      background-color 0.2s ease,
      border-color 0.2s ease,
      box-shadow 0.25s ease;
  }

  .btn:hover {
    translate: 0 -2px;
  }

  /* The ink itself: dark by day, light by night. */
  .primary {
    background: var(--ink);
    color: var(--surface);
    box-shadow: var(--glow-cyan);
  }

  .primary:hover {
    box-shadow: 0 18px 36px -14px color-mix(in srgb, var(--accent) 65%, transparent);
  }

  /* Frosted glass, edged with a line. */
  .ghost {
    border-color: var(--line-soft);
    background: var(--glass);
    color: var(--ink);
  }

  .ghost:hover {
    border-color: color-mix(in srgb, var(--accent) 45%, transparent);
  }

  @media (prefers-reduced-motion: reduce) {
    .btn {
      transition: none;
    }

    .btn:hover {
      translate: none;
    }
  }

  /* On paper, a link reads as words, and one to another site gives its
     address, as the page can no longer be clicked. */
  @media print {
    .btn {
      min-height: 0;
      padding: 0;
      border: 0;
      background: none;
      box-shadow: none;
      color: var(--ink);
    }

    .btn :global(.icon) {
      display: none;
    }

    .btn[data-address]::after {
      content: attr(data-address);
      color: var(--muted);
      font: 400 var(--text-s) / 1 var(--font-ui);
    }
  }
</style>
