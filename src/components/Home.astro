---
// The home page, the same in both languages apart from its words. A
// placeholder until the real home page arrives: honest about it, and already
// showing the first finished project, with proof that it runs.
import Base from '../layouts/Base.astro';
import Button from './Button.astro';
import Chip from './Chip.astro';
import Panel from './Panel.astro';
import Terminal from './Terminal.astro';
import { links } from '../links';
import { ui, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];

const stack = [
  'Kubernetes',
  'Terraform',
  'AWS EKS',
  'k3d',
  'Argo CD',
  'Gateway API',
  'External Secrets',
  'Vault',
  'Prometheus',
  'Grafana',
  'Sloth',
  'GitHub Actions',
];

// As the platform-eks-gitops README shows it, from a real run.
const verify = `
$ make local-verify
checking the local platform:
  ok    Argo CD applications                       all applications healthy
  ok    gateway, HTTP listener                     listener answers (HTTP 404)
  ok    gateway, HTTPS listener                    TLS terminated, issuer CN=platform-local-ca
  ok    secret synced from Vault                   "stored in Vault, never in git"
  ok    Grafana behind the gateway                 reachable over HTTPS (HTTP 200)
  ok    demo API behind the gateway                answers through the gateway
  ok    demo API scraped by Prometheus             ServiceMonitor in place
  ok    SLO rules from Sloth                       6 rule groups generated by Sloth
  ok    SLO dashboard in Grafana                   dashboard shipped with the application
`;
---

<Base lang={lang} title={t.title} description={t.description}>
  <section class="hero wrap" aria-labelledby="name">
    <Chip tone="amber" live>{t.status}</Chip>
    <p class="eyebrow">{t.kicker}</p>
    <h1 id="name">Olivier Guandalini</h1>
    <p class="lede">{t.lede}</p>
    <div class="cluster actions">
      <Button href="#project">{t.seeProject}</Button>
      <Button href="#contact" variant="ghost">{t.contact}</Button>
    </div>
  </section>

  <div class="wrap">
    <Panel as="article" id="project" class="project" aria-labelledby="project-title">
      <div class="about">
        <Chip tone="green" dot>{t.projectStatus}</Chip>
        <h2 id="project-title">platform-eks-gitops</h2>
        <p class="summary">{t.projectSummary}</p>
        <ul class="cluster" aria-label={t.projectStack}>
          {
            stack.map((name) => (
              <li>
                <Chip>{name}</Chip>
              </li>
            ))
          }
        </ul>
        <Button href={links.platform}>{t.projectCode}</Button>
      </div>
      <div class="proof">
        <Terminal title="~/platform-eks-gitops" transcript={verify} />
        <p class="note">{t.projectMeasured}</p>
      </div>
    </Panel>
  </div>
</Base>

<style>
  .hero {
    display: grid;
    justify-items: start;
    gap: var(--space-5);
    padding-block: clamp(var(--space-7), 12vh, var(--space-9)) var(--space-8);
  }

  .hero h1 {
    margin-block: calc(-1 * var(--space-2));
  }

  .actions {
    gap: var(--space-3);
    margin-top: var(--space-2);
  }

  .project {
    display: grid;
    gap: var(--space-7);
    scroll-margin-top: var(--space-5);
  }

  .about {
    display: grid;
    justify-items: start;
    gap: var(--space-5);
    max-width: 46rem;
  }

  .summary {
    color: var(--ink-2);
  }

  .proof {
    display: grid;
    gap: var(--space-3);
    min-width: 0;
  }

  .note {
    color: var(--muted);
    font-size: var(--text-s);
  }
</style>
