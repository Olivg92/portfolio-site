---
// The home page, the same in both languages apart from its words: who I am
// in two sentences beside the platform drawn in isometric view, then the
// three projects.
import { getRelativeLocaleUrl } from 'astro:i18n';
import Base from '../layouts/Base.astro';
import Button from './Button.astro';
import IsoPlatform from './IsoPlatform.astro';
import ProjectCard from './ProjectCard.astro';
import Terminal from './Terminal.astro';
import { projects } from '../projects';
import { ui, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
const [featured, ...others] = projects;

// As the platform-eks-gitops README shows it, from a real run.
const verify = `
$ make local-verify
checking the local platform:
  ok    Argo CD applications                       all applications healthy
  ok    gateway, HTTP listener                     listener answers (HTTP 404)
  ok    gateway, HTTPS listener                    TLS terminated, issuer CN=platform-local-ca
  ok    secret synced from Vault                   "stored in Vault, never in git"
  ok    Grafana behind the gateway                 reachable over HTTPS (HTTP 200)
  ok    demo API behind the gateway                answers through the gateway
  ok    demo API scraped by Prometheus             ServiceMonitor in place
  ok    SLO rules from Sloth                       6 rule groups generated by Sloth
  ok    SLO dashboard in Grafana                   dashboard shipped with the application
`;
---

<Base lang={lang} title={t.title} description={t.description}>
  <section class="hero wrap" aria-labelledby="name">
    <div class="intro">
      <p class="eyebrow">{t.kicker}</p>
      <h1 id="name">Olivier Guandalini</h1>
      <p class="lede">{t.positioning}</p>
      <div class="cluster actions">
        <Button href="#projects">{t.seeProjects}</Button>
        <Button href={getRelativeLocaleUrl(lang, 'experience/')} variant="ghost">
          {t.experience.mine}
        </Button>
      </div>
    </div>
    <IsoPlatform lang={lang} class="scene" />
  </section>

  <section id="projects" class="projects wrap" aria-labelledby="projects-title">
    <div class="head">
      <p class="eyebrow">{t.projects}</p>
      <h2 id="projects-title">{t.projectsTitle}</h2>
      <p class="lede">{t.projectsLede}</p>
      <p class="hint">{t.toolsHint}</p>
    </div>

    <ProjectCard project={featured} lang={lang}>
      <div class="proof">
        <Terminal title="~/platform-eks-gitops" transcript={verify} />
        <p class="note">{t.measured}</p>
      </div>
    </ProjectCard>

    <div class="pair">
      {others.map((project) => <ProjectCard project={project} lang={lang} />)}
    </div>
  </section>
</Base>

<style>
  .hero {
    display: grid;
    align-items: center;
    gap: var(--space-7);
    padding-block: var(--space-7) var(--space-8);
  }

  .intro {
    display: grid;
    justify-items: start;
    gap: var(--space-5);
  }

  .intro h1 {
    font-size: clamp(2.75rem, 1.5rem + 4.2vw, 4.75rem);
  }

  .actions {
    gap: var(--space-3);
    margin-top: var(--space-2);
  }

  @media (min-width: 1024px) {
    .hero {
      grid-template-columns: minmax(0, 4.6fr) minmax(0, 7.4fr);
      gap: var(--space-6);
      min-height: min(760px, calc(100svh - 92px));
      padding-block: var(--space-5) var(--space-7);
    }
  }

  .projects {
    display: grid;
    gap: var(--space-6);
    scroll-margin-top: var(--space-5);
  }

  .head {
    display: grid;
    gap: var(--space-4);
    margin-bottom: var(--space-3);
  }

  /* The chips open a card: said once, quietly, above them. */
  .hint {
    color: var(--muted);
    font: 500 var(--label) / 1.6 var(--font-mono);
    letter-spacing: 0.04em;
  }

  .proof {
    display: grid;
    gap: var(--space-3);
    min-width: 0;
  }

  .note {
    color: var(--muted);
    font-size: var(--text-s);
  }

  .pair {
    display: grid;
    gap: var(--space-6);
  }

  @media (min-width: 900px) {
    .pair {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
