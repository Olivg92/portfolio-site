---
// The bottom of every page, and its contact section: the header's "Contact"
// link lands here, whatever the page. Its links to the pages are the way
// around on a phone, where the header has no room for them.
import { getRelativeLocaleUrl } from 'astro:i18n';
import Button from './Button.astro';
import { links } from '../links';
import { cvFile, cvPath } from '../cv';
import { ui, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
const year = new Date().getFullYear();
---

<footer class="foot" id="contact" aria-labelledby="contact-title">
  <div class="wrap">
    <div class="reach reveal">
      <h2 id="contact-title" class="eyebrow">{t.contact}</h2>
      <p class="talk">{t.talk}</p>
      <p class="text">{t.contactText}</p>
      <ul class="cluster">
        <li><Button href={links.linkedin}>LinkedIn</Button></li>
        <li><Button href={links.github} variant="ghost">GitHub</Button></li>
        <li class="cv"><Button href={cvPath(lang)} variant="ghost" download={cvFile(lang)}>{t.cv.short}</Button></li>
      </ul>
    </div>
    <nav class="pages" aria-label={t.pages}>
      <a href={`${getRelativeLocaleUrl(lang)}#projects`}>{t.projects}</a>
      <a href={getRelativeLocaleUrl(lang, 'experience/')}>{t.experience.nav}</a>
    </nav>
    <p class="meta">
      <span>© {year} Olivier Guandalini</span>
      <a href={links.source} target="_blank" rel="noopener">
        {t.source}
        <span class="visually-hidden">{t.newTab}</span>
      </a>
      <span>{t.builtWith}</span>
    </p>
  </div>
</footer>

<style>
  .foot {
    margin-top: var(--space-9);
    padding-block: 0 var(--space-6);
    scroll-margin-top: var(--space-5);
  }

  /* The contact, as one large tile washed with the aurora's colours. */
  .reach {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
    padding: clamp(var(--space-6), 5vw, 56px);
    border: 1px solid color-mix(in srgb, var(--surface) 85%, transparent);
    border-radius: var(--radius-xl);
    background: linear-gradient(
      130deg,
      color-mix(in srgb, var(--violet) 28%, var(--surface)),
      color-mix(in srgb, var(--sky-blue) 24%, var(--surface)) 60%,
      color-mix(in srgb, var(--sky-pink) 20%, var(--surface))
    );
    box-shadow: var(--shadow-panel);
  }

  :global(.night) .reach {
    border-color: var(--line-soft);
  }

  .eyebrow {
    line-height: 1.6;
  }

  .talk {
    font: 800 clamp(2.75rem, 1.4rem + 5vw, 5.25rem) / 0.95 var(--font-display);
    letter-spacing: -0.045em;
  }

  .text {
    max-width: 30em;
    color: var(--ink-2);
    font-size: var(--text-l);
    line-height: 1.5;
    text-wrap: balance;
  }

  .reach .cluster {
    margin-top: var(--space-3);
  }

  .pages {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    margin-top: var(--space-8);
    font-size: var(--text-s);
  }

  .pages a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--ink-2);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    margin-top: var(--space-4);
    color: var(--muted);
    font-size: var(--text-s);
  }

  .meta a {
    color: var(--ink-2);
  }

  /* On paper, the contact only: where to write, with the addresses, and not
     the CV, which the paper already is. */
  @media print {
    .cv {
      display: none;
    }

    .foot {
      margin-top: var(--space-7);
      padding-block: var(--space-5) 0;
      break-inside: avoid;
    }

    .reach {
      gap: var(--space-2);
      padding: 0;
      border: 0;
      background: none;
      box-shadow: none;
    }

    .talk {
      display: none;
    }

    .text {
      color: var(--ink);
      font-size: var(--text-l);
    }

    .pages,
    .meta {
      display: none;
    }
  }
</style>
